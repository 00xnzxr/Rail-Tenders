# Python
__pycache__/
*.py[cod]
venv/
.env
.env.local
.env.*.local
*.egg-info/

# Node
node_modules/

# Build outputs (ignore frontend dist, but keep extension dist — it IS the loadable extension)
drpl-frontend/dist/
# TypeScript incremental-build state; regenerated by every `tsc -b`, so a
# tracked copy is a guaranteed diff on every build and a conflict on every merge.
*.tsbuildinfo

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Uploads
uploads/

# Local SQLite dev/test DB (default database_url = sqlite:///./drpl_local.db)
drpl_local.db
*.sqlite
*.sqlite3
*.db-journal

# Alembic
alembic/versions/*.py
!alembic/versions/.gitkeep

# Logs (uvicorn tees, analyzer runs, etc.)
*.log
drpl-backend/logs/

# System Pilot ephemeral workbench (per package)
drpl-backend/.tmp/*
drpl-frontend/.tmp/*
drpl-extension/.tmp/*
!drpl-backend/.tmp/.gitkeep
!drpl-frontend/.tmp/.gitkeep
!drpl-extension/.tmp/.gitkeep
.superdesign/tmp/

# One-off backfill undo manifests — environment-specific row ids, not source.
drpl-backend/scripts/*.undo.json

# GeM collector: the Chrome profile it can borrow a session from, and its local ledger
.gem-chrome-profile/
.ireps-profile/
collector_local.db

# Build artifacts: not needed to deploy, and GitHub push protection
# flagged secrets inside the committed SQLite dev database.
*.zip
