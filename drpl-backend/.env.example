# DRPL Backend Configuration
# Copy this to .env and fill in your values

# Database — SQLite by default, no setup needed for local testing.
DATABASE_URL=sqlite:///./drpl_local.db

# Switch to PostgreSQL for production:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT Secret — generate your own with: openssl rand -base64 48
JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=720

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# File Storage (for tender document uploads)
UPLOAD_DIR=./uploads

# Storage backend: "local" (filesystem, dev only) or "r2" (Cloudflare R2, prod)
STORAGE_BACKEND=local

# Cloudflare R2 — required when STORAGE_BACKEND=r2
# Create the bucket + API token at https://dash.cloudflare.com → R2 → "Manage R2 API Tokens"
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET_NAME=drpl-platform-prod
# R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# PRESIGNED_URL_TTL_SECONDS=3600

# AI Pipeline (Phase 2)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# RunPod serverless OCR (PaddleOCR-VL). Used by the scanned-page OCR cascade
# (PlatformSetting pdf_ocr_provider). Both empty = provider skipped.
# RUNPOD_API_KEY=rpa_...
# RUNPOD_OCR_ENDPOINT_ID=gcn0fedjph2hj2

# Self-hosted chat model on a SECOND RunPod endpoint (vLLM, OpenAI-compatible).
# Used only by the `local_model_probe` agent, which sits on no production path.
#
# Only the KEY needs setting: the endpoint id and the model ship as defaults
# (config.runpod_chat_endpoint_id / runpod_chat_model), and the PlatformSettings
# of the same names override either without a redeploy.
#
# RunPod scopes keys per endpoint on this account -- the OCR key returns 403 on
# the chat endpoint and vice versa, measured both ways -- so this is its own
# key. Setting it never touches RUNPOD_API_KEY, which OCR needs.
#
# The model id must be what the endpoint SERVES, not what the dashboard shows:
# it answers to "qwen2.5-7b" and returns 500 for "Qwen/Qwen2.5-7B-Instruct".
# RUNPOD_CHAT_API_KEY=rpa_...
# RUNPOD_CHAT_ENDPOINT_ID=9d05slartfxnql
# RUNPOD_CHAT_MODEL=qwen2.5-7b

# Google Gemini (Search Grounding - primary web search provider)
# GOOGLE_API_KEY=your-google-api-key
# GEMINI_SEARCH_MODEL=gemini-2.5-flash

# Web Search (optional - falls back to DuckDuckGo if not set)
# TAVILY_API_KEY=tvly-...

# Redis + RQ (Phase C concurrency)
# Leave REDIS_URL empty for local/dev — the app degrades to inline sync runs
# and the RQ worker exits cleanly. On Railway, attach the Redis plugin and
# the platform injects REDIS_URL automatically.
# REDIS_URL=redis://default:password@host:6379
# RQ_QUEUE_NAME=drpl-runs
# REDIS_CACHE_TTL_SECONDS=300

# GeM Search: outbound proxy for the collector. GeM's firewall drops cloud egress
# addresses (Railway included); point this at an HTTP or SOCKS5 proxy with an
# Indian address. Empty = direct. Admin > Platform Settings > gem_proxy_url overrides.
GEM_PROXY_URL=
